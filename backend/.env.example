# MongoDB connection string (MongoDB Atlas or local)
MONGODB_URI=mongodb://127.0.0.1:27017/algonauts

# Secret used to sign JWTs - use a long random string in production
JWT_SECRET=replace_me_with_a_long_random_string

# Port the API listens on
PORT=3001

# Comma-separated list of origins allowed to call this API
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# development | production
NODE_ENV=development

# Rate limiting. Production defaults are 5 auth attempts and 100 API calls per
# 15 minutes; raise them locally so development and seeding aren't blocked.
AUTH_RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MIN=15
API_RATE_LIMIT_MAX=1000
API_RATE_LIMIT_WINDOW_MIN=15
